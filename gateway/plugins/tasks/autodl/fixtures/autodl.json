    {
      "name": "text-to-video defaults to the cheapest standard workflow",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "requestBody": {
            "model": "minimax-h3-video",
            "prompt": "a cat"
          },
          "model": "minimax-h3-video",
          "upstreamModel": "minimax-h3-video",
          "baseUrl": "https://autodl.art",
          "apiKey": "test-token",
          "action": ""
        }
      ],
      "expected": {
        "url": "https://autodl.art/api/v1/comfyui/comfyui_workflow/minimax_h3_lightx2v_no_pic",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "Authorization": "test-token"
        },
        "body": {
          "prompt": "a cat",
          "resolution": "768p竖",
          "duration": 5
        },
        "action": "text_to_video"
      }
    },
