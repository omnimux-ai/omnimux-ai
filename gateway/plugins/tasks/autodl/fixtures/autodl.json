    {
      "name": "content requests proxy the short-lived upstream URL",
      "hook": "buildContentRequest",
      "args": [
        {
          "artifactKey": "video",
          "data": {
            "code": 0,
            "data": {
              "status": "SUCCESS",
              "results": [
                "https://cdn.example/out.mp4"
