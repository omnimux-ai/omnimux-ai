          "headers": {}
        }
      ],
      "expected": {
        "status": "SUCCESS",
        "progress": "100%",
        "url": "https://cdn.example/out.mp4?sig=1"
      }
    },
    {
      "name": "SUCCESS accepts object results",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "code": 0,
          "data": {
            "status": "SUCCESS",
            "results": [
              {
                "url": "https://cdn.example/out.mp4"
              }
            ]
          }
        },
        {
          "status": 200,
          "headers": {}
        }
      ],
      "expected": {
        "status": "SUCCESS",
        "progress": "100%",
        "url": "https://cdn.example/out.mp4"
      }
    },
    {
      "name": "FAILED maps to FAILURE with the upstream reason",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "code": 0,
          "data": {
            "status": "FAILED",
            "msg": "nsfw"
          }
        },
        {
          "status": 200,
          "headers": {}
        }
      ],
      "expected": {
        "status": "FAILURE",
        "progress": "100%",
        "reason": "nsfw"
      }
    },
    {
      "name": "a busy envelope is a failure, not a poll failure",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "code": 5001,
          "msg": "upstream busy"
        },
        {
          "status": 200,
          "headers": {}
        }
      ],
      "expected": {
        "status": "FAILURE",
        "progress": "100%",
        "reason": "upstream busy"
      }
    },
    {
      "name": "an unknown status stays UNKNOWN",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "code": 0,
          "data": {
            "status": "PAUSED"
          }
        },
        {
          "status": 200,
          "headers": {}
        }
      ],
      "expected": {
        "status": "UNKNOWN",
        "reason": "unrecognized status: PAUSED"
      }
    },
    {
      "name": "video facts carry seconds and the resolved tier",
      "hook": "extractUsage",
      "args": [
        {
          "requestBody": {
            "model": "minimax-h3-video",
            "prompt": "a cat",
            "resolution": "768p",
            "duration": 6
          },
          "model": "minimax-h3-video",
          "upstreamModel": "minimax-h3-video"
        }
      ],
      "expected": {
        "seconds": 6,
        "resolution": "768p"
      }
    },
    {
      "name": "billing ratios use the same facts",
      "hook": "extractUsage",
      "args": [
        {
          "requestBody": {
            "model": "minimax-h3-video",
            "prompt": "a cat",
            "resolution": "480p",
            "duration": 6
          },
          "model": "minimax-h3-video",
          "upstreamModel": "minimax-h3-video",
          "usagePurpose": "billing_ratios"
        }
      ],
      "expected": {
        "seconds": 6,
        "resolution": "480p"
      }
    },
    {
      "name": "motion transfer reports seconds only",
      "hook": "extractUsage",
      "args": [
        {
          "requestBody": {
            "model": "wan-2-2-animate",
            "ref_image": "https://cdn.example/a.png",
            "ref_video": "https://cdn.example/v.mp4",
            "duration": 9
          },
          "model": "wan-2-2-animate",
          "upstreamModel": "wan-2-2-animate"
        }
      ],
      "expected": {
        "seconds": 9
      }
    },
    {
      "name": "per-second speech synthesis reports usage facts with floor",
      "hook": "extractUsage",
      "args": [
        {
          "requestBody": {
            "model": "indextts-2",
            "prompt_text": "你好",
            "prompt_simple": "https://cdn.example/v.wav"
          },
          "model": "indextts-2",
          "upstreamModel": "indextts-2"
        }
      ],
      "expected": {
        "seconds": 10
      }
    },
    {
      "name": "completion bills the requested duration, not the upstream processing time",
      "hook": "extractUsageOnComplete",
      "args": [
        {
          "state": {
            "billingMode": "per_second",
            "seconds": 5,
            "resolution": "768p"
          }
        },
        {
          "status": "SUCCESS"
        },
        {
          "code": 0,
          "data": {
            "status": "SUCCESS",
            "duration": 123
          }
        }
      ],
      "expected": {
        "seconds": 5,
        "resolution": "768p"
      }
    },
    {
      "name": "a 1s 1088p request is never billed as its 123s processing time",
      "hook": "extractUsageOnComplete",
      "args": [
        {
          "state": {
            "billingMode": "per_second",
            "seconds": 1,
            "resolution": "1088p"
          }
        },
        {
          "status": "SUCCESS"
        },
        {
          "code": 0,
          "data": {
            "status": "SUCCESS",
            "duration": 123,
            "results": [{ "url": "https://cdn.example/clip.mp4" }]
          }
        }
      ],
      "expected": {
        "seconds": 1,
        "resolution": "1088p"
      }
    },
    {
      "name": "completion reports the requested duration when the upstream omits duration",
      "hook": "extractUsageOnComplete",
      "args": [
        {
          "state": {
            "billingMode": "per_second",
            "seconds": 5,
            "resolution": "736p"
          }
        },
        {
          "status": "SUCCESS"
        },
        {
          "code": 0,
          "data": {
            "status": "SUCCESS"
          }
        }
      ],
      "expected": {
        "seconds": 5,
        "resolution": "736p"
      }
    },
    {
      "name": "completion reports nothing for per-call models",
      "hook": "extractUsageOnComplete",
      "args": [
        {
          "state": {
            "billingMode": "per_call"
          }
        },
        {
          "status": "SUCCESS"
        },
        {
          "code": 0,
          "data": {
            "status": "SUCCESS"
          }
        }
      ],
      "expected": null
    },
    {
      "name": "a finished task exposes one video artifact",
      "hook": "listArtifacts",
      "args": [
        {
          "taskId": "t1",
