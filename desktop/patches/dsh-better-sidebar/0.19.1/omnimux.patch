+      const c = source[position]!
+      if (c === ',' && parentheses === 0) break
+      if (c === '(') parentheses++
+      if (c === ')' && parentheses > 0) parentheses--
+      position++
+    }
+    const descriptors = source.slice(descriptorStart, position).trim()
+    position++
