+/** Stable build identity for CSS while retaining the absolute disk path separately. */
+function stableCssId(absolutePath: string): string {
+  const repositoryPath = relative(REPOSITORY_ROOT, absolutePath).split(sep).join('/')
+  if (!repositoryPath.startsWith('../')) return repositoryPath
+  const normalized = absolutePath.split(sep).join('/')
+  const nodeModules = normalized.lastIndexOf('/node_modules/')
+  if (nodeModules < 0) throw new Error(`CSS path is outside the repository and dependency tree: ${absolutePath}`)
+  const dependencyPath = normalized.slice(nodeModules + '/node_modules/'.length)
+  return `node_modules/${dependencyPath}`
+}
 
