{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omnimux-ai/omnimux-ai/versions.schema.json",
  "title": "OmniMux component version lock",
  "type": "object",
  "required": ["schema", "updatedAt", "components"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "components": {
      "type": "object",
      "required": ["gateway", "desktop", "plugins"],
      "additionalProperties": false,
      "properties": {
        "gateway": { "$ref": "#/$defs/component" },
        "desktop": { "$ref": "#/$defs/component" },
        "plugins": {
          "allOf": [{ "$ref": "#/$defs/component" }],
          "type": "object",
          "properties": {
            "packages": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": ["repo", "branch", "commit", "license"],
      "properties": {
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$" },
        "visibility": { "enum": ["public", "private"] },
        "branch": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "version": { "type": "string" },
        "license": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
