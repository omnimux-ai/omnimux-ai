{
  "name": "omnimux-clip",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib/client.js",
    "scripts/build-client.mjs",
    "tailwind.openreel.config.js",
    "skills",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE",
    "LICENSE.openreel.txt",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "prepare": "npm run build",
    "test": "node --test src/*.test.js src/timeline/*.test.js src/client/store/timelineStore.test.js src/client/*.test.js",
    "prepack": "node scripts/build-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "@gsap/react": "^2.1.2",
    "@paper-design/shaders": "^0.0.76",
    "@paper-design/shaders-react": "^0.0.76",
    "dsh-ui-kit": "file:../../packages/dsh-ui-kit",
    "framer-motion": "^12.0.0",
    "gsap": "^3.14.2",
    "idb-keyval": "^6.2.2",
    "immer": "^11.0.1",
    "lucide-react": "^0.555.0",
    "mediabunny": "^1.25.3",
    "motion": "^12.0.0",
    "polygon-clipping": "0.15.7",
    "react-syntax-highlighter": "^16.1.0",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "uuid": "^13.0.0",
    "zustand": "^4.5.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.6 || >=0.2.1-rc.3 <0.3.0-0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "license": "SEE LICENSE IN LICENSE",
  "description": "OmniMux Clip: official OpenReel GUI + pipeline as a DSH better-sidebar Tab."
}
