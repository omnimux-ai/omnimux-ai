{
  "id": "omnimux",
  "name": "omnimux",
  "version": "0.1.2",
  "tier": "tier-0-hub",
  "entrypoint": "src/index.js",
  "status": "active",
  "description": "OmniMux 执行枢纽：负责身份认证注入、模型与多模态路由分发、页面抓取与品牌注入",
  "tags": ["hub", "core", "auth", "routing", "media", "reader", "chrome"],
  "capabilities": {
    "tools": [
      { "name": "omnimux_page_fetch", "summary": "抓取网页并提取为干净 Markdown", "category": "reader", "isWriteOperation": false, "requiresAuth": false },
      { "name": "omnimux_text_complete", "summary": "调用 Hub 统一大模型文本生成接口", "category": "text", "isWriteOperation": false, "requiresAuth": true },
      { "name": "omnimux_jev_decision", "summary": "调用 TypeSafe Jev 决策模型执行结构化决策与评分", "category": "decision", "isWriteOperation": false, "requiresAuth": true }
    ],
    "seamsProvided": [
      { "name": "identity", "interfaceDoc": "ctx.get('identity').status / .require() / .getSnapshot()" },
      { "name": "textComplete", "interfaceDoc": "ctx.get('textComplete').generate(params)" },
      { "name": "modelCatalog", "interfaceDoc": "ctx.get('modelCatalog').list() → { source, fingerprint, defaults, text, image, video, audio }" },
      { "name": "decisions", "interfaceDoc": "ctx.get('decisions').evaluate(params)" }
    ],
    "seamsConsumed": [],
    "slots": [
      { "target": "brand.chrome", "componentPath": "src/client/chrome.js" },
      { "target": "sidebar.extra", "componentPath": "src/client/app-tabs.js" },
      { "target": "shell.overlay", "componentPath": "src/client/AppsStage.jsx" }
    ],
    "storageDomains": ["$DSH_HOME/omnimux/"]
  },
  "dependencies": {
    "requiredPlugins": [],
    "systemBinaries": []
  }
}
