{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnimux.ai/apps/catalog.schema.json",
  "title": "OmniMux official Apps catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at", "min_hub", "apps"],
  "properties": {
    "schema": { "const": 1 },
    "generated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[.][0-9]+Z)$" },
    "min_hub": { "type": "string", "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$" },
    "apps": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "summary", "kind", "listed", "capabilities", "client", "spec"],
        "properties": {
          "id": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 40 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 160 },
          "kind": { "const": "official" },
          "listed": { "type": "boolean" },
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["identity", "videoGenerate", "imageGenerate", "official"] }
          },
          "client": { "type": "boolean" },
          "spec": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "name"],
            "properties": {
              "source": { "enum": ["npm", "bundled"] },
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
