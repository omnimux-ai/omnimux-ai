{
  "name": "omnimux-publish",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "lib/client.js",
    "scripts/build-client.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "prepare": "npm run build",
    "test": "node --test src/*.test.js src/shared/*.test.js src/client/*.test.js",
    "typecheck:contracts": "tsc -p tsconfig.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "dsh-ui-kit": "file:../../packages/dsh-ui-kit"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.6 || >=0.2.1-rc.3 <0.3.0-0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@types/node": "^25.9.4",
    "typescript": "~5.9.3",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "license": "SEE LICENSE IN LICENSE",
  "description": "omnimux-publish: social publishing orchestration layer over OmniMux hub publish tools. Drafts, per-account subtask ledger, publish/retry/refresh, agent tools + local web UI."
}
