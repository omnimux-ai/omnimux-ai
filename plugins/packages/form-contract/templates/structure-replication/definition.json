{
  "protocolVersion": 1,
  "id": "structure-replication",
  "templateVersion": "1.0.1",
  "title": "保留结构复刻",
  "description": "保持参考视频的镜头结构与节奏，根据新主题组织复刻需求。",
  "examples": [
    {
      "ref": "/api/omnimux/forms/examples/replication-demo.mp4",
      "title": "原创产品结构示意：开场、细节、收尾",
      "kind": "video"
    }
  ],
  "fields": [
    {
      "id": "reference_video",
      "type": "file",
      "label": "参考视频",
      "required": true,
      "accept": [
        "video/mp4",
        "video/webm"
      ],
      "maxFiles": 1,
      "maxBytes": 104857600
    },
    {
      "id": "brief",
      "type": "textarea",
      "label": "任务说明",
      "required": true,
      "minLength": 1,
      "maxLength": 2000
    },
    {
      "id": "aspect_ratio",
      "type": "aspect-ratio",
      "label": "画面比例",
      "required": true,
      "options": [
        {
          "value": "16:9",
          "label": "16:9"
        },
        {
          "value": "1:1",
          "label": "1:1"
        },
        {
          "value": "9:16",
          "label": "9:16"
        }
      ],
      "default": "9:16"
    },
    {
      "id": "duration",
      "type": "slider",
      "label": "目标时长（秒）",
      "required": true,
      "min": 5,
      "max": 60,
      "step": 1,
      "default": 15
    },
    {
      "id": "count",
      "type": "number",
      "label": "方案数量",
      "required": true,
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 1
    }
  ],
  "prompt": "请基于附带参考视频设计复刻方案，保留镜头结构、节奏与核心表达。\n新主题与要求：{{brief}}\n目标画幅：{{aspect_ratio}}\n目标时长：{{duration}} 秒\n方案数量：{{count}}\n以上是创作目标，不代表模型已支持这些参数；执行前确认可用能力。",
  "attachments": [
    "reference_video"
  ]
}
